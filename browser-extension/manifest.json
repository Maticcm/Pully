{
  "manifest_version": 3,
  "name": "Pully Browser Integration",
  "version": "1.0.0",
  "description": "Lets the Pully desktop app see supported pages you already have open, so you can send them over without copying a link.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["tabs", "nativeMessaging", "contextMenus", "storage"],
  "minimum_chrome_version": "116"
}
